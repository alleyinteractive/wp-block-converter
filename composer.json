{
    "name": "alleyinteractive/wp-block-converter",
    "description": "Convert HTML into Gutenberg Blocks with PHP",
    "type": "library",
    "keywords": [
        "alleyinteractive",
        "wp-block-converter"
    ],
    "homepage": "https://github.com/alleyinteractive/wp-block-converter",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alley Interactive",
            "email": "info@alley.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "alleyinteractive/wp-bulk-task": "^1.0",
        "illuminate/macroable": "^13.21",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "mantle-framework/testkit": "^1.22",
        "php-stubs/wp-cli-stubs": "^2.12",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Alley\\WP\\BlockConverter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alley\\WP\\BlockConverter\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan --memory-limit=512M",
        "phpunit": "phpunit",
        "phpunit-wordpress": "phpunit -c phpunit-wordpress.xml",
        "pint": "pint",
        "pint-test": "pint --test",
        "test": [
            "@phpstan",
            "@phpunit",
            "@phpunit-wordpress"
        ]
    }
}
