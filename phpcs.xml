<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="wp-block-converter" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
  <description>PHP_CodeSniffer standard for wp-block-converter.</description>

  <!-- This library has no WordPress dependency of its own (aside from the optional
  WordPressImageUploader, see CLAUDE.md), so it uses plain PSR-12 rather than a WordPress-based
  ruleset. See docs/adr/0001-adopt-psr-12.md. -->
  <rule ref="PSR12" />

  <!-- Enforce camelCase property/variable names (PSR-1 StudlyCaps/camelCase rename). -->
  <rule ref="Squiz.NamingConventions.ValidVariableName" />

  <!-- Keep `use` imports alphabetically sorted. -->
  <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses" />

  <!-- Enforce a consistent member order within classes/traits: uses, enum cases, constants by
  visibility, properties (static before instance per visibility), constructor, destructor, magic
  methods, __invoke, methods (static before instance per visibility). Every group PHP_CodeSniffer
  is aware of must be listed (even ones this codebase never uses, like enum cases or abstract/final
  methods) or the sniff throws a MissingClassGroupsException. -->
  <rule ref="SlevomatCodingStandard.Classes.ClassStructure">
    <properties>
      <property name="groups" type="array">
        <element value="uses" />
        <element value="enum cases" />
        <element value="public constants" />
        <element value="protected constants" />
        <element value="private constants" />
        <element value="public static properties" />
        <element value="public properties" />
        <element value="protected static properties" />
        <element value="protected properties" />
        <element value="private static properties" />
        <element value="private properties" />
        <element value="constructor" />
        <element value="static constructors" />
        <element value="destructor" />
        <element value="magic methods" />
        <element value="invoke method" />
        <element value="public static final methods, public static abstract methods, public static methods" />
        <element value="public final methods, public abstract methods, public methods" />
        <element value="protected static final methods, protected static abstract methods, protected static methods" />
        <element value="protected final methods, protected abstract methods, protected methods" />
        <element value="private static methods" />
        <element value="private methods" />
      </property>
    </properties>
  </rule>

  <!-- ConvertToBlocksCommand interacts with WP_CLI's $post argument, a WP_Post object whose own
  snake_case properties (post_content, post_title, etc.) are external WordPress core API, not
  identifiers this codebase controls. -->
  <rule ref="Squiz.NamingConventions.ValidVariableName.MemberNotCamelCaps">
    <exclude-pattern>src/ConvertToBlocksCommand.php</exclude-pattern>
  </rule>

  <!-- Test fixtures contain long heredoc HTML/JSON literals that must match the converter's exact
  output byte-for-byte — wrapping them would change the string under test, not just its formatting. -->
  <rule ref="Generic.Files.LineLength">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>

  <!--
  Pass some flags to PHPCS:
    p flag: Show progress of the run.
    s flag: Show sniff codes in all reports.
  -->
  <arg value="ps" />

  <!-- Whenever possible, cache the scan results and re-use those for unchanged files on the next scan. -->
  <arg name="cache" value=".phpcs.cache.json" />

  <!-- Strip the filepaths down to the relevant bit. -->
  <arg name="basepath" value="./" />

  <!-- Check up to 20 files simultaneously. -->
  <arg name="parallel" value="20" />

  <!-- Set severity to 1 to see everything that isn't effectively turned off. -->
  <arg name="severity" value="1" />

  <!-- Exclude Composer dependencies. -->
  <exclude-pattern>vendor/</exclude-pattern>
</ruleset>
