<?xml version="1.0"?>
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
  bootstrap="tests/wordpress/bootstrap.php"
  backupGlobals="false"
  colors="true"
  cacheDirectory=".phpunit-wordpress.result.cache"
>
  <testsuites>
    <testsuite name="feature">
      <directory suffix=".php">tests/wordpress/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="MANTLE_USE_SQLITE" value="true" />
    <env name="WP_SKIP_DB_CREATE" value="true" />
  </php>
</phpunit>
